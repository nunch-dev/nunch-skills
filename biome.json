{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "biome.json",
      "package.json",
      "tsconfig.json",
      "npm/scripts/**/*.mjs",
      "npm/src/**/*.ts",
      "npm/test/**/*.{mjs,ts}",
      "tools/upstream-sync/src/**/*.ts",
      "tools/upstream-sync/test/**/*.ts",
      "plugins/nch-installer/.codex-plugin/plugin.json",
      "plugins/nch-installer/hooks/hooks.json",
      "plugins/nch-installer/runtime/src/**/*.ts",
      "plugins/nch-installer/runtime/test/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "trailingNewline": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useImportType": "error"
      }
    }
  }
}
