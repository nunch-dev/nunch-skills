{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nunch-skills manifest",
  "type": "object",
  "required": ["version", "scope", "agents", "sources"],
  "properties": {
    "version": { "const": 1 },
    "scope": { "const": "global" },
    "agents": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "skills"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "skills": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
