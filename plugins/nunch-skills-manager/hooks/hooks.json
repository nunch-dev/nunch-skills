{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/run-manager.sh\" hook",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\scripts\\run-manager.ps1\" hook",
            "timeout": 15,
            "statusMessage": "Checking nunch-skills updates"
          }
        ]
      }
    ]
  }
}
