{
  "name": "@nunch-dev/skills",
  "version": "0.1.4",
  "packageManager": "pnpm@10.32.1",
  "description": "Release-pinned lifecycle CLI for nunch-skills.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nunch-skills": "npm/bin/nunch-skills.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nunch-dev/nunch-skills.git"
  },
  "bugs": {
    "url": "https://github.com/nunch-dev/nunch-skills/issues"
  },
  "homepage": "https://github.com/nunch-dev/nunch-skills#readme",
  "files": [
    "LICENSE",
    "README.md",
    "release-manifest.json",
    ".agents/plugins/marketplace.json",
    "npm/bin/nunch-skills.mjs",
    "plugins/nch-installer/.codex-plugin/plugin.json",
    "plugins/nch-installer/hooks/hooks.json",
    "plugins/nch-installer/runtime/nch-installer.mjs",
    "plugins/nch-installer/scripts/node-dispatch.ps1",
    "tools/upstream-sync/dist/upstream-sync.mjs"
  ],
  "scripts": {
    "build": "node npm/scripts/build-typescript.mjs",
    "dev:cli": "node --experimental-strip-types npm/src/entry.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "test": "node --test npm/test/*.test.mjs && node --experimental-strip-types --test npm/test/*.test.ts tools/upstream-sync/test/*.test.ts plugins/nch-installer/runtime/test/*.test.ts",
    "test:fast": "node scripts/test-fast.mjs",
    "test:upstream-sync": "node --experimental-strip-types --test tools/upstream-sync/test/*.test.ts",
    "pack:check": "node npm/scripts/pack-check.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm test && pnpm run pack:check"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "commander": "15.0.0",
    "posthog-node": "5.50.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
