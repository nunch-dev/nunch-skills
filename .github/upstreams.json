{
  "upstreams": [
    {
      "name": "i-have-adhd",
      "repository": "https://github.com/ayghri/i-have-adhd.git",
      "ref": "main",
      "copies": [
        {
          "source": "skills/i-have-adhd",
          "destination": "plugins/nunch-skills/skills/i-have-adhd",
          "removeFrontmatter": [
            "disable-model-invocation"
          ]
        },
        {
          "source": "LICENSE",
          "destination": "plugins/nunch-skills/licenses/i-have-adhd-LICENSE"
        },
        {
          "source": "logo.png",
          "destination": "plugins/nunch-skills/assets/i-have-adhd-logo.png"
        },
        {
          "source": "hooks/always-on.mjs",
          "destination": "plugins/nunch-skills/hooks/i-have-adhd-always-on.mjs"
        }
      ]
    },
    {
      "name": "humanize-korean",
      "repository": "https://github.com/epoko77-ai/im-not-ai.git",
      "ref": "main",
      "copies": [
        {
          "source": "agents",
          "destination": "plugins/nunch-skills/agents"
        },
        {
          "source": "scripts",
          "destination": "plugins/nunch-skills/scripts/humanize-korean"
        },
        {
          "source": "skills/humanize",
          "destination": "plugins/nunch-skills/skills/humanize",
          "removeFrontmatter": [
            "disable-model-invocation",
            "argument-hint"
          ]
        },
        {
          "source": "skills/humanize-korean",
          "destination": "plugins/nunch-skills/skills/humanize-korean",
          "removeFrontmatter": [
            "disable-model-invocation",
            "version"
          ]
        },
        {
          "source": "skills/humanize-redo",
          "destination": "plugins/nunch-skills/skills/humanize-redo",
          "removeFrontmatter": [
            "disable-model-invocation",
            "argument-hint"
          ]
        },
        {
          "source": "LICENSE",
          "destination": "plugins/nunch-skills/licenses/humanize-korean-LICENSE"
        }
      ]
    }
  ]
}
